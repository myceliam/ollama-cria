{
  "$schema": "./schemas/acceptance.schema.json",
  "formatVersion": 1,
  "note": "Stage 9 (docs/RESTORE.md, C-46). Kept by hand. Each auto row is one safe call: read-only, or a search, page read or short speech with no effect outside the stack. Rows with a real-world effect are user rows. Stage 9 also checks that every tool, function and enabled tool server in the OWUI seed is covered, and adds one row per model preset from 'models'.",
  "groups": {
    "1": "Local inference",
    "2": "Cloud providers",
    "3": "MCP and OpenAPI tool servers",
    "4": "Web search",
    "5": "Page reading",
    "6": "Image and video",
    "7": "Speech to text",
    "8": "Text to speech",
    "9": "Notifications",
    "10": "Calendar and Gmail",
    "11": "Filters",
    "12": "Bolt and open-terminal from the VPS",
    "13": "Model presets and skills",
    "14": "Other tools",
    "15": "Dashboard and Dozzle"
  },
  "rows": [
    {
      "id": "ollama-models",
      "group": 1,
      "who": "auto",
      "owner": 6,
      "what": "Ollama lists its models",
      "probe": {
        "type": "http",
        "url": "http://127.0.0.1:11434/api/tags",
        "contains": "\"models\""
      }
    },
    {
      "id": "local-chat",
      "group": 1,
      "who": "user",
      "owner": 3,
      "what": "A local model answers in OWUI",
      "steps": "In OWUI on this PC, start a new chat with a local Ollama model and ask a short question. It answers, and 'ollama ps' shows the model at 100% GPU."
    },
    {
      "id": "cloud-chat",
      "group": 2,
      "who": "user",
      "owner": 7,
      "what": "OpenAI, Anthropic and Cline each answer",
      "steps": "In OWUI, send one short message through each cloud connection: an OpenAI model, an Anthropic model and a Cline model from the model menu. Each answers."
    },
    {
