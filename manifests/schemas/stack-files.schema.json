{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myceliam/ollama-cria/blob/main/manifests/schemas/stack-files.schema.json",
  "title": "ollama-cria stack file list",
  "description": "The files tools/Sync-StackFiles.ps1 copies from the live PC and VPS into this repo, by source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "host",
        "root",
        "repoFolder",
        "purpose",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "host": {
          "enum": [
            "pc",
            "vps"
          ]
        },
        "root": {
          "description": "pc: a full Windows path, environment variables allowed (%APPDATA%). vps: an absolute path.",
          "type": "string",
          "minLength": 2
        },
        "repoFolder": {
          "description": "Where the files land in this repo, with the same layout as under root.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*(/[a-z][a-z0-9._-]*)*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
          }
        }
      }
    }
  }
}
