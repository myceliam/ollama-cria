{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myceliam/ollama-cria/blob/main/manifests/schemas/endpoints.schema.json",
  "title": "ollama-cria endpoint list",
  "description": "Every templated file in this repo and the endpoint placeholders it holds (RESTORE.md Stage 4a, Appendix E). Written by tools/Sync-StackFiles.ps1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "placeholders"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
          },
          "placeholders": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^([A-Z][A-Z0-9_]*_TS_(IP|IP6|NAME)|TS_DOMAIN)$"
            }
          }
        }
      }
    }
  }
}
