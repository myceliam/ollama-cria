{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myceliam/ollama-cria/blob/main/manifests/schemas/acceptance.schema.json",
  "title": "ollama-cria acceptance rows",
  "description": "Stage 9's functional tests (RESTORE.md Stage 9, C-46): one row per capability. An auto row has a probe the stage runs; a user row has steps for Liam, answered with -Accept <id>. Every tool, function and enabled tool server in the OWUI seed must be covered by a row; every model preset gets a generated row from 'models'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "groups",
    "rows",
    "models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "groups": {
      "description": "The capability groups of RESTORE.md's Stage 9 table, by number.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^([1-9]|1[0-9])$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "who",
          "owner",
          "what"
        ],
        "properties": {
          "id": {
            "description": "Unique. A user row is accepted with -Accept <id>.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._-]{0,79}$"
          },
          "group": {
            "type": "integer",
            "minimum": 1,
            "maximum": 19
          },
          "who": {
            "enum": [
              "auto",
              "user"
            ]
          },
          "owner": {
            "description": "The stage a failure goes back to.",
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "what": {
            "description": "One line for the report.",
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "description": "Seed items this row tests: tool:<id> or function:<id>.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(tool|function):[A-Za-z0-9_.-]+$"
            }
          },
          "server": {
            "description": "A regular expression matched against the URL of an enabled tool server connection in the seed: the row tests that server. A row that matches none is skipped.",
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "description": "User rows: what Liam does and what he should see.",
            "type": "string",
            "minLength": 1
          },
          "probe": {
            "$ref": "#/$defs/probe"
          }
        },
        "if": {
          "properties": {
            "who": {
              "const": "auto"
            }
          }
        },
        "then": {
          "required": [
            "probe"
          ],
          "not": {
            "required": [
              "steps"
            ]
          }
        },
        "else": {
          "required": [
            "steps"
          ],
          "not": {
            "required": [
              "probe"
            ]
          }
        }
      }
    },
    "models": {
      "description": "Every model preset in the seed gets a generated row: an active one must answer this prompt through OWUI's chat API; one built on a pipe function is covered by that function's rows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "owner",
        "prompt",
        "timeoutSec"
      ],
      "properties": {
        "group": {
          "type": "integer",
          "minimum": 1,
          "maximum": 19
        },
        "owner": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 10,
          "maximum": 900
        }
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "http: one request from this PC. mcpo: POST /<server>/<operation> on mcpo-core, or its tool list when there is no operation. owui-load: OWUI loads a tool's or function's code. vps: one request from the VPS, as root, with no credentials.",
          "enum": [
            "http",
            "mcpo",
            "owui-load",
            "vps"
          ]
        },
        "url": {
          "description": "http and vps. http: 127.0.0.1 or {{PC_TS_IP}} / {{VPS_TS_IP}}. vps: a tailnet placeholder address.",
          "type": "string",
          "pattern": "^http://(127\\.0\\.0\\.1|\\{\\{(PC|VPS)_TS_IP\\}\\}):[0-9]{1,5}/[A-Za-z0-9._~/?&=%+-]*$"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "uses": {
          "description": "Which credential the request carries, read at run time and never written down: owui (the API key Stage 7 left), mcpo, terminal, pstool, gcal or gmail (from the rendered .env files).",
          "enum": [
            "none",
            "owui",
            "mcpo",
            "terminal",
            "pstool",
            "gcal",
            "gmail"
          ]
        },
        "body": {
          "description": "A JSON body (http POST and mcpo)."
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "anyStatus": {
          "description": "Any HTTP answer passes: the row tests reachability only.",
          "type": "boolean"
        },
        "contains": {
          "description": "Text the answer must contain.",
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "description": "Top-level fields of a JSON answer and the values they must have.",
          "type": "object"
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "server": {
          "description": "mcpo: the server's name in mcpo-core's config.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "operation": {
          "description": "mcpo: the tool to call. Without one, the server must list at least one tool.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "description": "owui-load: tool or function.",
          "enum": [
            "tool",
            "function"
          ]
        },
        "id": {
          "description": "owui-load: the tool's or function's id.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "http",
                  "vps"
                ]
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mcpo"
              }
            }
          },
          "then": {
            "required": [
              "server"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "owui-load"
              }
            }
          },
          "then": {
            "required": [
              "kind",
              "id"
            ]
          }
        }
      ]
    }
  }
}
