{
  "$schema": "./schemas/secrets.schema.json",
  "formatVersion": 1,
  "rows": [
    {
      "id": "stack-env",
      "folder": "01",
      "location": "stack:.env",
      "kind": "file",
      "required": true,
      "purpose": "Main stack settings and provider API keys"
    },
    {
      "id": "ntfy-pc-token",
      "folder": "01",
      "location": "stack:secrets/ntfy-pc.token",
      "kind": "file",
      "required": true,
      "purpose": "ntfy publisher token for PC alerts (Docker secret)"
    },
    {
      "id": "ntfy-pcmon-password",
      "folder": "01",
      "location": "stack:secrets/ntfy-pcmon.pw",
      "kind": "file",
      "required": true,
      "purpose": "ntfy password for the PC monitor account (Docker secret)"
    },
    {
      "id": "ntfy-phone-password",
      "folder": "01",
      "location": "stack:secrets/ntfy-phone.pw",
      "kind": "file",
      "required": true,
      "purpose": "ntfy password for the phone account (Docker secret)"
    },
    {
      "id": "google-oauth-client",
      "folder": "02",
      "location": "stack:secrets/gcp-oauthkeys.json",
      "kind": "file",
      "required": true,
      "purpose": "Google OAuth client for the gcal and Gmail bridges (Docker secret)"
    },
    {
      "id": "gcal-bridge-env",
      "folder": "02",
      "location": "stack:gcal-owui-bridge/.env",
      "kind": "file",
      "required": true,
      "purpose": "gcal bridge settings and its OWUI API key"
    },
    {
      "id": "gcal-oauth-token",
      "folder": "02",
      "location": "stack:gcal-owui-bridge/data/token.json",
      "kind": "file",
      "required": false,
      "purpose": "gcal bridge OAuth token; if missing or expired, re-run the consent flow"
    },
    {
      "id": "gmail-bridge-env",
      "folder": "02",
      "location": "stack:gmail-owui-bridge/.env",
      "kind": "file",
      "required": true,
      "purpose": "Gmail bridge settings and its OWUI API key"
    },
    {
      "id": "gmail-oauth-token",
      "folder": "02",
      "location": "stack:gmail-owui-bridge/data/gmail_token.json",
      "kind": "file",
      "required": false,
      "purpose": "Gmail bridge OAuth token; if missing or expired, re-run the consent flow"
    },
    {
      "id": "ssh-vps-key",
      "folder": "04",
      "location": "ssh:liam-vps",
      "kind": "file",
      "required": true,
      "purpose": "Private key the vps alias uses"
    },
    {
      "id": "ssh-vps-key-public",
      "folder": "04",
      "location": "ssh:liam-vps.pub",
      "kind": "file",
      "required": true,
      "purpose": "Matching public key"
    },
    {
      "id": "ssh-config",
      "folder": "04",
      "location": "ssh:config",
      "kind": "file",
      "required": true,
      "purpose": "SSH aliases, including vps"
    },
    {
      "id": "vps-egress-env",
      "folder": "05",
      "location": "vps-egress:.env",
      "kind": "file",
      "required": true,
      "mode": "0600",
      "owner": "liam",
      "purpose": "WireGuard keys, Mullvad endpoint, Brave key and SearXNG secret"
    },
    {
      "id": "ntfy-user-db",
      "folder": "07",
      "location": "ntfy-data:user.db",
      "kind": "sqlite",
      "required": true,
      "purpose": "ntfy accounts, tokens and permissions; without it the phone must be re-paired"
    },
    {
      "id": "bolt-server-keys",
      "folder": "07",
      "location": "bolt-data:server-keys.json",
      "kind": "file",
      "required": true,
      "purpose": "Bolt server identity; without it every Bolt client must be re-keyed"
    }
  ],
  "audits": [
    {
      "location": "stack:secrets",
      "purpose": "Every Docker secret file must have a row, so a new secret cannot be left out silently"
    }
  ]
}
